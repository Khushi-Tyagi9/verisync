# Copy to .env and adjust. .env is gitignored.

# Razorpay webhook secret. Must match the secret configured on the webhook in
# the Razorpay dashboard (Phase 7). For local hand-signed tests (Phase 3), any
# value works as long as the signer and the server agree.
RAZORPAY_WEBHOOK_SECRET=local_dev_webhook_secret

# Redpanda / Kafka. Host apps connect on 19092 (see docker-compose.yml).
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
LIFECYCLE_TOPIC=order-lifecycle-events

# Postgres. Host port is 15432 (see docker-compose.yml).
POSTGRES_DSN=postgresql://verisync:verisync@localhost:15432/verisync

# Redis. Used by the Phase 4 worker for the idempotency pre-filter and the
# recheck delay queue. Host port is 16379 (see docker-compose.yml).
REDIS_URL=redis://localhost:16379/0

# Reconciliation worker (Phase 4). Consumer group for the lifecycle topic.
WORKER_CONSUMER_GROUP=verisync-worker

# Merchant simulator (Phase 5). Own consumer group; lag_seconds is when a
# 'lagging' order's paid event fires (default 900s, past the recheck window).
MERCHANT_SIM_CONSUMER_GROUP=merchant-sim
MERCHANT_SIM_LAG_SECONDS=900

# Serverless live mode (Vercel + Neon, no Kafka or Redis). Off unless set.
# DASHBOARD_LIVE_MODE=1 enables POST /api/orders, POST /api/tick and the order form.
# DASHBOARD_LIVE_MODE=0
# Optional: require this token (X-Write-Token or Bearer) on order submission.
# DASHBOARD_WRITE_TOKEN=
# Global cap on order_LIVE_ rows; submissions beyond it are refused (HTTP 429).
# DASHBOARD_LIVE_MAX_ORDERS=500
# Demo timings in seconds: recheck window, lagging merchant, immediate merchant.
# DASHBOARD_LIVE_RECHECK_SECONDS=20
# DASHBOARD_LIVE_LAG_SECONDS=60
# DASHBOARD_LIVE_IMMEDIATE_SECONDS=2
# Max items each tick stage processes.
# DASHBOARD_LIVE_TICK_LIMIT=20
